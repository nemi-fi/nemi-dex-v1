{
  "name": "@nemi-fi/interface-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "compile:json-files": "if [ ! -f src/scripts/deploy/deployments-dynamic.json ]; then echo '{}' > src/scripts/deploy/deployments-dynamic.json; fi; if [ ! -f src/scripts/deploy/currency-list-dynamic.json ]; then echo '{}' > src/scripts/deploy/currency-list-dynamic.json; fi;",
    "test:runtime": "vitest run --pass-with-no-tests",
    "test:static": "tsc --noEmit --emitDeclarationOnly false && prettier --check .",
    "test:static:fix": "prettier --write .",
    "aztec:deploy": "tsx src/scripts/deploy/run-deploy.ts"
  },
  "dependencies": {
    "@aztec-labs/accounts": "catalog:",
    "@aztec-labs/aztec.js": "catalog:",
    "@aztec-labs/constants": "catalog:",
    "@aztec-labs/ethereum": "catalog:",
    "@aztec-labs/foundation": "catalog:",
    "@aztec-labs/noir-contracts.js": "catalog:",
    "@aztec-labs/stdlib": "catalog:",
    "@aztec-labs/wallet-sdk": "catalog:",
    "@aztec-labs/wallets": "catalog:",
    "@nemi-fi/aztec-deploy": "workspace:*",
    "@nemi-fi/contracts": "workspace:*",
    "@nemi-fi/utils": "workspace:*",
    "@nemi-fi/v1-sdk": "workspace:*",
    "@uniswap/sdk-core": "catalog:",
    "lodash-es": "catalog:",
    "ms": "catalog:",
    "ox": "catalog:",
    "ts-essentials": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/ms": "catalog:",
    "consola": "^3.4.2",
    "dotenv": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
