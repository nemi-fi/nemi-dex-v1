{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",

    // compatibility
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true, // needed by allowImportingTsExtensions
    "allowImportingTsExtensions": true, // for dynamic imports in turbopack

    // lib
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // strictness
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "noUncheckedIndexedAccess": true
  }
}
